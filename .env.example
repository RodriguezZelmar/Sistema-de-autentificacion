# Copiá este archivo como .env y completá los valores.
# .env está en .gitignore: NUNCA subas secretos reales al repositorio.

# --- JWT ---
# Clave para firmar los access tokens (HMAC-SHA256). Mínimo 32 caracteres, aleatoria.
# Cómo generar una: ver la sección "Variables de entorno" del README.
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-chars
JWT_ISSUER=auth-api
JWT_AUDIENCE=auth-api-clients
JWT_ACCESS_TOKEN_MINUTES=15

# --- Refresh tokens ---
REFRESH_TOKEN_DAYS=7

# --- Recuperación de contraseña ---
PASSWORD_RESET_TOKEN_MINUTES=15
# true SOLO en demo/desarrollo: devuelve el token en la respuesta en vez de enviarlo por email.
PASSWORD_RESET_EXPOSE_TOKEN=true

# --- Hashing de contraseñas ---
# Costo de BCrypt (10-12 es razonable; más alto = más lento).
BCRYPT_WORK_FACTOR=12

# --- Rate limiting de /auth (intentos por minuto por IP) ---
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- Base de datos (SQLite) ---
DATABASE_CONNECTION=Data Source=auth.db

# --- Usuario administrador de demo ---
# Si ambas variables están definidas, al arrancar se crea este usuario con rol ADMIN (si no existe).
# Es la ÚNICA forma de obtener un ADMIN: el endpoint de registro siempre asigna USER.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-Admin123
